# ACE Platform Environment Variables
# Copy this to .env and fill in your actual values

# Security
ACE_SECRET=your_super_secret_random_key_here_change_this_in_production
ACE_DB_URI=sqlite:///ace.db

# Supabase Auth (server-side only)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# For production, use PostgreSQL:
# ACE_DB_URI=postgresql://user:password@host:port/database

# Example (Supabase Postgres via SQLAlchemy):
# ACE_DB_URI=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Server Config
PORT=5000
FLASK_ENV=development

# CORS (for production, set to your frontend URL)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Production example:
# CORS_ORIGINS=https://your-ace-platform.com
